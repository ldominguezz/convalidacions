        </select>
      </div>

      <div>
        <label for="llei" class="block text-sm font-semibold text-gray-700 mb-1"
          >Selecciona la llei</label
        >
        <select
          id="llei"
          name="llei"
          required
          class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2.5 bg-white text-gray-700 border"
        >
          <option value="" disabled selected>-- Selecciona la llei --</option>

          {lleisUniques.map((llei) => <option value={llei}>{llei}</option>)}
        </select>
      </div>
    </div>
    -->
    <!-- Cicles concrets (origen i destí) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label
          for="origen"
          class="block text-sm font-semibold text-gray-700 mb-1"
          >Quins estudis aportes? (Origen)</label
        >
        <select
          id="origen"
          name="origen"
          required
          class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2.5 bg-white text-gray-700"
        >
          <option value="" disabled selected
            >-- Selecciona el teu títol previ --</option
          >
          {
            ciclesPrincipals.map((c) => (
              <option value={c.id_cicle} data-familia={c.id_familia} data-grau={c.grau}>
                {c.llei != "LOE" ? `[${c.grau} - ${c.llei}] ` : `[${c.grau}] `}
                {c.nom}
              </option>
            ))
          }
        </select>

        <div class="mt-2 flex items-center gap-2">
          <input
            type="checkbox"
            id="mostra-antics"
            class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500"
          />
          <label for="mostra-antics" class="text-sm text-gray-600 select-none">
            Mostra també cicles LOGSE i CP
          </label>
        </div>

        <script
          type="application/json"
          id="cicles-antics-data"
          set:html={JSON.stringify(ciclesAntics).replace(/</g, "\\u003c")}
        />

        <script
          type="application/json"
          id="comodins-data"
          set:html={JSON.stringify(comodinsData).replace(/</g, "\\u003c")}
        />
      </div>

      <div>
        <label
          for="desti"
          class="block text-sm font-semibold text-gray-700 mb-1"
          >Què vols estudiar? (Destí)</label
        >
        <select
          id="desti"
          name="desti"
          required
          class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2.5 bg-white text-gray-700 border"
        >
          <option value="" disabled selected
            >-- Selecciona el cicle a cursar --</option
          >
          {
            ciclesDesti.map((c) => (
              <option value={c.id_cicle} data-codi={c.codi}>
                {`[${c.grau}]`} - {c.nom}
              </option>
            ))
          }
        </select>
      </div>
    </div>

    <button
      type="button"
      id="btn-consultar"
      class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
    >
      Consultar Convalidacions
    </button>

    <div id="resultats-container" class="mt-10 hidden">
      <h2 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
        Resultat de la consulta
      </h2>

      <div
        class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 rounded-lg"
      >
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th
                scope="col"
                class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900"
                >Mòdul a Convalidar (Destí)</th
              >
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
                >Mòdul Prèvi (Origen)</th
              >
              <th
                scope="col"
                class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
                >Regla / Nota</th
              >
            </tr>
          </thead>
          <tbody id="taula-body" class="divide-y divide-gray-200 bg-white">
          </tbody>
        </table>
      </div>

      <div
        id="missatge-buit"
        class="hidden mt-4 p-4 bg-yellow-50 text-yellow-800 rounded-md border border-yellow-200"
      >
        No s'han trobat convalidacions directes per a aquesta combinació de
        cicles.
      </div>
      <button
        type="submit"
        id="btn-generar"
        class="w-full flex justify-center mt-4 py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors"
      >
        Generar Documentació
      </button>
    </div>
  </form>
</div>

<script>
  import { createClient } from "@supabase/supabase-js";
  import { generarDocument } from "../scripts/generateDoc";
  import { validateDocument } from "../scripts/validateDNI";

  // Agafem les variables directament (assegura't que comencen per PUBLIC_)
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = createClient(supabaseUrl, supabaseKey);

  const form = document.getElementById(
    "form-convalidacions",
  ) as HTMLFormElement;
  const btnConsultar = document.getElementById(
    "btn-consultar",
  ) as HTMLButtonElement;
  const resultatsContainer = document.getElementById("resultats-container");
  const missatgeBuit = document.getElementById("missatge-buit");
  const taulaBody = document.getElementById(
    "taula-body",
  ) as HTMLTableSectionElement;

  let resultatConvalidacions: Array<{
    codiModul: string;
    nomDesti: string;
    nomOrigen: string;
    reglaNota: string;
  }> = [];

  // --- Cicles LOGSE/CP: es mostren a l'origen només si es marca el checkbox ---
  const ciclesAnticsRaw =
    document.getElementById("cicles-antics-data")?.textContent || "[]";
  const ciclesAnticsClient = JSON.parse(ciclesAnticsRaw);
  const comodinsRaw =
    document.getElementById("comodins-data")?.textContent || "{}";
  const comodins: {
    anyLoeId: number | null;
    perFamilia: Record<string, number>;
    perFamiliaGrau: Record<string, Record<string, number>>;
  } = JSON.parse(comodinsRaw);

  const origenSelect = document.getElementById("origen") as HTMLSelectElement;
  const checkboxAntics = document.getElementById(
    "mostra-antics",
  ) as HTMLInputElement;

  function crearOptionAntic(c: any): HTMLOptionElement {
    const opt = document.createElement("option");
    opt.value = c.id_cicle;
    opt.dataset.familia = c.id_familia;
    opt.dataset.grau = c.grau;
    opt.textContent =
      c.grau === "CP" ? `[CP] ${c.nom}` : `[${c.grau} - ${c.llei}] ${c.nom}`;
    return opt;
  }

  let optgroupAntics: HTMLOptGroupElement | null = null;

  checkboxAntics?.addEventListener("change", () => {
    if (checkboxAntics.checked) {
      optgroupAntics = document.createElement("optgroup");
      optgroupAntics.label = "LOGSE / CP";
      ciclesAnticsClient.forEach((c: any) =>
        optgroupAntics!.appendChild(crearOptionAntic(c)),
      );
      origenSelect.appendChild(optgroupAntics);
    } else {
      optgroupAntics?.remove();
      optgroupAntics = null;
      if (
        origenSelect.selectedOptions[0]?.parentElement?.tagName === "OPTGROUP"
      ) {
        origenSelect.value = "";
      }
    }
  });

  if (form) {
    if (btnConsultar) {
      btnConsultar?.addEventListener("click", async (e) => {
        e.preventDefault();

        resultatConvalidacions = [];
        // Obtenim els valors dels selects
        const origenSelectEl = document.getElementById(
          "origen",
        ) as HTMLSelectElement;
        const origenId = origenSelectEl.value;
        const origenOpt = origenSelectEl.selectedOptions[0];
        const origenFamiliaId = origenOpt?.dataset.familia;
        const origenGrau = origenOpt?.dataset.grau;

        const idsOrigen = [Number(origenId)];
        if (comodins.anyLoeId) idsOrigen.push(comodins.anyLoeId);
        if (origenFamiliaId && comodins.perFamilia[origenFamiliaId]) {
          idsOrigen.push(comodins.perFamilia[origenFamiliaId]);
        }
        if (
          origenFamiliaId &&
          origenGrau &&
          comodins.perFamiliaGrau[origenFamiliaId]?.[origenGrau]
        ) {
          idsOrigen.push(comodins.perFamiliaGrau[origenFamiliaId][origenGrau]);
        }

        const destiId = (document.getElementById("desti") as HTMLSelectElement)
          .value;

        if (!origenId || !destiId) return;

        // Estat visual de càrrega
        resultatsContainer?.classList.remove("hidden");
        missatgeBuit?.classList.add("hidden");

        // Si són el mateix cicle, mostrem un missatge
        if (origenId === destiId) {
          taulaBody.innerHTML =
            '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">No es pot comparar el mateix cicle.</td></tr>';
          return;
        }

        taulaBody.innerHTML =
          '<tr><td colspan="3" class="px-6 py-8 text-center text-gray-500">Buscant convalidacions...</td></tr>';

        try {
          const { data, error } = await supabase
            .from("convalidacions")
            .select(
              `
          regla_nota,
          modul_desti:moduls!id_modul_desti(codi_modul, nom),
          modul_origen:moduls!id_modul_origen(nom)
        `,
            )
            .in("id_cicle_origen", idsOrigen)
            .eq("id_cicle_desti", destiId);

          if (error) {
            console.error("Error de Supabase:", error.message);
            throw error;
          }

          // Ordenem per codi de mòdul destí abans de pintar la taula
          data?.sort((a: any, b: any) => {
            const codiA =
              (Array.isArray(a.modul_desti) ? a.modul_desti[0] : a.modul_desti)
                ?.codi_modul ?? "";
            const codiB =
              (Array.isArray(b.modul_desti) ? b.modul_desti[0] : b.modul_desti)
                ?.codi_modul ?? "";
            return codiA.localeCompare(codiB, undefined, { numeric: true });
          });

          taulaBody.innerHTML = "";

          if (!data || data.length === 0) {
            missatgeBuit?.classList.remove("hidden");
            return;
          }

          data.forEach((fila: any) => {
            const mDesti = Array.isArray(fila.modul_desti)
              ? fila.modul_desti[0]
              : fila.modul_desti;
            const mOrigen = Array.isArray(fila.modul_origen)
              ? fila.modul_origen[0]
              : fila.modul_origen;

            resultatConvalidacions.push({
              codiModul: mDesti?.codi_modul ?? "",
              nomDesti: mDesti?.nom ?? "Mòdul desconegut",
              nomOrigen: mOrigen?.nom ?? "Títol complet aportat",
              reglaNota: fila.regla_nota ?? "",
            });
            const textDesti = mDesti
              ? `<strong>${mDesti.codi_modul}</strong> - ${mDesti.nom}`
              : "Mòdul desconegut";

            const textOrigen = mOrigen
              ? mOrigen.nom
              : '<span class="italic text-gray-400">Títol complet aportat</span>';

            // --- LÒGICA PER A LA COLUMNA DE LA DRETA (NOTES) ---
            let badgeNota = "";
            if (fila.regla_nota === "CINC") {
              badgeNota =
                '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">5 (CV)</span>';
            } else if (fila.regla_nota === "MATEIXA_NOTA") {
              badgeNota =
                '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Nota del mòdul</span>';
            } else if (fila.regla_nota === "MITJANA_CICLE") {
              badgeNota =
                '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">Nota mitjana cicle</span>';
            } else {
              // Si no coincideix amb cap, mostrem el text tal qual o un per defecte
              badgeNota = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">${fila.regla_nota || "Consultar"}</span>`;
            }

            const tr = document.createElement("tr");
            tr.innerHTML = `
              <td class="py-4 pl-4 pr-3 text-sm text-gray-900">${textDesti}</td>
              <td class="px-3 py-4 text-sm text-gray-500">${textOrigen}</td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">${badgeNota}</td>
            `;
            taulaBody?.appendChild(tr);
          });
        } catch (err) {
          const errorMessage = err instanceof Error ? err.message : String(err);
          taulaBody.innerHTML = `<tr><td colspan="3" class="px-6 py-8 text-center text-red-500">Error: ${errorMessage}</td></tr>`;
        }
      });
    }
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const nom = (document.getElementById("nom") as HTMLInputElement)?.value;
      const dni = (document.getElementById("dni") as HTMLInputElement)?.value;

      const dniResult = validateDocument(dni);
      if (!dniResult.valid) {
        alert(`DNI/NIE incorrecte: ${dniResult.error}`);
        (document.getElementById("dni") as HTMLInputElement)?.focus();
        return; // Atura l'enviament
      }

      const destiSelect = document.getElementById("desti") as HTMLSelectElement;
      const nomDestiRaw = destiSelect.options[destiSelect.selectedIndex].text;
      const cicleCodi =
        destiSelect.options[destiSelect.selectedIndex].dataset.codi ?? "";

      // Extreu el grau
      const grau = nomDestiRaw.includes("CFGS") ? "superior" : "mitjà";

      // Extreu el nom net (tot el que hi ha després del "- ")
      const cicleNom = nomDestiRaw.replace(/^\[.*?\]\s*-\s*/, "").trim();

      // Funció per convertir la regla a nota numèrica
      const reglaNota = (regla: string): number => {
        if (regla === "CINC") return 5;
        if (regla === "MATEIXA_NOTA") return 0;
        if (regla === "MITJANA_CICLE") return 0;
        return 0;
      };

      const genere = (document.getElementById("genere") as HTMLSelectElement)
        ?.value;

      await generarDocument(
        {
          nomAlumne: nom,
          dni: dni,
          genere: genere,
          grau: grau,
          cicleNom: cicleNom,
          cicleCodi: cicleCodi,
          moduls: resultatConvalidacions.map((c) => ({
            codi: c.codiModul,
            nom: c.nomDesti,
            nota: reglaNota(c.reglaNota),
          })),
          directora: "Ingrid Pifarré Ferri",
          data: new Date().toLocaleDateString("ca-ES", {
            day: "numeric",
            month: "long",
            year: "numeric",
          }),
          ciutat: "Barcelona",
          nomCentre: "Centre d'Estudis Roca",
          subtitolCentre: "ESO – Batxillerat – Cicles Formatius",
          logoPath: "../assets/logo.jpg",
        },
        nom + ".docx",
      );
      resultatConvalidacions = [];
      console.log("Dades per al document:", {
        nom,
        dni,
        grau,
        cicleNom,
        convalidacions: resultatConvalidacions,
      });
    });
  }
</script>