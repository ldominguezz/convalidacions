---
// Aquest codi s'executa al servidor (Server-Side Rendering)
import { createClient } from "@supabase/supabase-js";

// Inicialitzem Supabase
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

// Obtenim tots els cicles de la base de dades, ordenats per la llei
const { data: cicles, error } = await supabase
  .from("cicles")
  .select("*")
  .order("id_cicle");

if (error) {
  console.error("Error carregant cicles:", error);
}

// Obtenim tots les families de la base de dades, ordenats per nom
const { data: families, error: errorFamilia } = await supabase
  .from("families")
  .select("*")
  .order("nom");

if (errorFamilia) {
  console.error("Error carregant families:", errorFamilia);
}

// Filtrem els de destí perquè només mostri CFGM i CFGS (excloent els Certificats) i que estiguin impartits
const ciclesDesti =
  cicles?.filter(
    (c) => (c.grau === "CFGM" || c.grau === "CFGS") && c.impartit === true,
  ) || [];

// Aquesta és la "fórmula màgica" en Javascript per obtenir valors únics
const lleisUniques = [...new Set(cicles?.map((c) => c.llei))];

// Cicles per al select d'ORIGEN: LOE (i altres no antics) es veuen per defecte
// (excloem grau 'ALTRES' perquè són comodins interns, no cicles reals seleccionables)
const ciclesPrincipals =
  cicles?.filter(
    (c) => c.llei !== "LOGSE" && c.grau !== "CP" && c.grau !== "ALTRES",
  ) || [];

// Cicles LOGSE i CP: només es veuen si l'usuari marca el checkbox
const ciclesAntics =
  cicles?.filter((c) => c.llei === "LOGSE" || c.grau === "CP") || [];

// Comodins: ANY_LOE (universal), FAM_* grau-agnòstics (p. ex. FAM_ADM, FAM_INF)
// i FAM_*_GM / FAM_*_GS (restringits a un grau concret dins la família)
const anyLoeCicle = cicles?.find((c) => c.codi === "ANY_LOE");

const comodinsPerFamilia: Record<number, number> = {};
const comodinsPerFamiliaGrau: Record<number, Record<string, number>> = {};

cicles?.forEach((c) => {
  if (c.grau !== "ALTRES" || c.codi === "ANY_LOE") return;

  if (c.codi.endsWith("_GM") || c.codi.endsWith("_GS")) {
    const grauObjectiu = c.codi.endsWith("_GM") ? "CFGM" : "CFGS";
    if (!comodinsPerFamiliaGrau[c.id_familia]) comodinsPerFamiliaGrau[c.id_familia] = {};
    comodinsPerFamiliaGrau[c.id_familia][grauObjectiu] = c.id_cicle;
  } else {
    comodinsPerFamilia[c.id_familia] = c.id_cicle;
  }
});

const comodinsData = {
  anyLoeId: anyLoeCicle?.id_cicle ?? null,
  perFamilia: comodinsPerFamilia,
  perFamiliaGrau: comodinsPerFamiliaGrau,
};
---

<div
  class="max-w-5xl mx-auto p-6 bg-white rounded-xl shadow-lg mt-10 border border-gray-100"
>
  <div class="mb-8 text-center">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
      Generador de Convalidacions FP
    </h1>
    <p class="mt-2 text-gray-500">
      Descobreix quins mòduls pots convalidar segons els teus estudis previs.
    </p>
  </div>

  <form
    id="form-convalidacions"
    class="space-y-6 bg-gray-50 p-6 rounded-lg border border-gray-200"
  >
    <!-- Dades personals -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <label for="nom" class="block text-sm font-semibold text-gray-700 mb-1"
          >Introdueix el teu nom complet</label
        >
        <input
          type="text"
          id="nom"
          name="nom"
          required
          class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2.5 bg-white text-gray-700"
        />
      </div>
      <div>
        <label for="dni" class="block text-sm font-semibold text-gray-700 mb-1"
          >Introdueix el teu dni</label
        >
        <input
          type="text"
          id="dni"
          name="dni"
          required
          class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2.5 bg-white text-gray-700"
        />
      </div>
      <div>
        <label for="dni" class="block text-sm font-semibold text-gray-700 mb-1"
          >Introdueix el gènere</label
        >
        <select
          id="genere"
          name="genere"
          required
          class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2.5 bg-white text-gray-700"
        >
          <option value="">Selecciona el gènere</option>
          <option value="m">Masculí</option>
          <option value="f">Femení</option>
          <option value="a">Altre</option>
        </select>
      </div>
    </div>

    <!-- Escollir Familia i llei -->
